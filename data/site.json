        "custom_html_head": "<!-- ===== 客服悬浮按钮 v3 ===== -->\n<style>\n  #cs-widget * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }\n  #cs-widget { position: fixed; right: 20px; bottom: 120px; z-index: 9999; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }\n\n  #cs-toggle {\n    width: 52px; height: 52px; border-radius: 50%;\n    background: #25D366; border: none; cursor: pointer;\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 4px 16px rgba(0,0,0,0.2); transition: transform .2s, background .2s;\n    font-size: 26px; line-height: 1;\n  }\n  #cs-toggle:hover { transform: scale(1.08); }\n  #cs-widget.open #cs-toggle { background: #888; }\n\n  #cs-panel {\n    background: #fff; border-radius: 16px;\n    box-shadow: 0 8px 32px rgba(0,0,0,0.15);\n    width: 270px; overflow: hidden;\n    max-height: 0; opacity: 0;\n    transition: max-height .35s ease, opacity .25s ease;\n    pointer-events: none;\n  }\n  #cs-widget.open #cs-panel { max-height: 620px; opacity: 1; pointer-events: all; }\n\n  \/* ── Tab 栏 ── *\/\n  .cs-tabs { display: flex; border-bottom: 1px solid #eee; background: #f5f5f5; }\n  .cs-tab {\n    flex: 1; padding: 11px 0; font-size: 13px; font-weight: 600;\n    text-align: center; cursor: pointer;\n    display: flex; align-items: center; justify-content: center; gap: 6px;\n    color: #25D366;                        \/* ← 灰色改为绿色 *\/\n    background: transparent;\n    border-bottom: 2px solid transparent;\n    transition: all .2s;\n}\n    \n  .cs-tab.active { background: #1a73e8; color: #fff; border-bottom-color: transparent; }\n  .cs-tab .tab-icon { width: 20px; height: 20px; flex-shrink: 0; }\n\n  \/* ── 内容区 ── *\/\n  .cs-pane { display: none; padding: 20px 18px; }\n  .cs-pane.active { display: block; }\n\n  \/* 二维码 *\/\n  .cs-qr-wrap {\n    background: #f7f7f7; border-radius: 10px;\n    padding: 14px; text-align: center; margin-bottom: 14px;\n  }\n  .cs-qr-wrap img { width: 164px; height: 164px; display: block; margin: 0 auto; border-radius: 6px; }\n  .cs-qr-label { font-size: 11px; color: #aaa; margin-top: 8px; }\n\n  \/* 通用绿色按钮 *\/\n  .cs-btn {\n    display: flex; align-items: center; justify-content: center; gap: 7px;\n    width: 100%; padding: 11px 0; border-radius: 8px; border: none;\n    font-size: 13px; font-weight: 600; cursor: pointer;\n    transition: opacity .15s; text-decoration: none;\n    background: #25D366; color: #fff;\n  }\n  .cs-btn:hover { opacity: .85; }\n  .cs-btn.copied { background: #43a047; }\n\n  \/* 微信号行 *\/\n  .cs-wxid {\n    background: #f7f7f7; border-radius: 8px; padding: 9px 12px;\n    font-size: 13px; color: #333;\n    display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;\n  }\n  .cs-wxid-label { font-size: 11px; color: #999; }\n  .cs-wxid span { font-weight: 600; letter-spacing: .5px; }\n<\/style>\n\n<div id=\"cs-widget\">\n\n  <div id=\"cs-panel\">\n    <!-- Tabs -->\n    <div class=\"cs-tabs\">\n      <!-- WhatsApp Tab -->\n      <div class=\"cs-tab active\" onclick=\"csTab('wa')\">\n        <svg class=\"tab-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n          <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"\/>\n        <\/svg>\n        WhatsApp\n      <\/div>\n      <!-- 微信 Tab：两个椭圆气泡 -->\n      <div class=\"cs-tab\" onclick=\"csTab('wx')\">\n        <svg class=\"tab-icon\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <ellipse cx=\"9.5\" cy=\"9.5\" rx=\"8\" ry=\"5.8\" fill=\"currentColor\" opacity=\".65\"\/>\n          <ellipse cx=\"16\" cy=\"15.5\" rx=\"7\" ry=\"5\" fill=\"currentColor\"\/>\n        <\/svg>\n        微信\n      <\/div>\n    <\/div>\n\n    <!-- WhatsApp 面板（全英文） -->\n    <div class=\"cs-pane active\" id=\"pane-wa\">\n      <div class=\"cs-qr-wrap\">\n        <!-- ★ 替换为你的 WhatsApp 二维码图片路径 -->\n        <img src=\"\/media\/files\/whatsapp.png\" alt=\"WhatsApp QR Code\" \/>\n        <div class=\"cs-qr-label\">Scan to add on WhatsApp<\/div>\n      <\/div>\n      <!-- ★ 替换手机号 -->\n      <a class=\"cs-btn\" href=\"https:\/\/wa.me\/8613800000000\" target=\"_blank\" rel=\"noopener\">\n        <svg style=\"width:17px;height:17px;fill:#fff;flex-shrink:0\" viewBox=\"0 0 24 24\">\n          <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"\/>\n        <\/svg>\n        Chat on WhatsApp\n      <\/a>\n    <\/div>\n\n    <!-- 微信面板 -->\n    <div class=\"cs-pane\" id=\"pane-wx\">\n      <div class=\"cs-qr-wrap\">\n        <!-- ★ 替换为你的微信二维码图片路径 -->\n        <img src=\"\/media\/files\/wechat.png\" alt=\"微信二维码\" \/>\n        <div class=\"cs-qr-label\">扫码添加微信<\/div>\n      <\/div>\n      <div class=\"cs-wxid\">\n        <span class=\"cs-wxid-label\">微信号<\/span>\n        <!-- ★ 替换微信号 -->\n        <span id=\"cs-wxid-val\">你的微信号<\/span>\n      <\/div>\n      <button class=\"cs-btn\" id=\"cs-copy-btn\" onclick=\"csCopyWx()\">\n        <svg style=\"width:16px;height:16px;fill:#fff;flex-shrink:0\" viewBox=\"0 0 24 24\">\n          <path d=\"M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z\"\/>\n        <\/svg>\n        一键复制微信号\n      <\/button>\n    <\/div>\n  <\/div>\n\n  <!-- 主触发按钮 -->\n  <button id=\"cs-toggle\" onclick=\"csToggle()\" title=\"联系客服\">💬<\/button>\n<\/div>\n\n<script>\n  var csOpen = false;\n  function csToggle() {\n    csOpen = !csOpen;\n    var w = document.getElementById('cs-widget');\n    var btn = document.getElementById('cs-toggle');\n    w.classList.toggle('open', csOpen);\n    btn.textContent = csOpen ? '✕' : '💬';\n    btn.style.fontSize = csOpen ? '20px' : '26px';\n  }\n  function csTab(tab) {\n    document.querySelectorAll('.cs-tab').forEach(function(t, i) {\n      t.classList.toggle('active', (tab === 'wa' && i === 0) || (tab === 'wx' && i === 1));\n    });\n    document.querySelectorAll('.cs-pane').forEach(function(p) { p.classList.remove('active'); });\n    document.getElementById('pane-' + tab).classList.add('active');\n  }\n  function csCopyWx() {\n    var id = document.getElementById('cs-wxid-val').innerText;\n    var btn = document.getElementById('cs-copy-btn');\n    function onCopied() {\n      btn.classList.add('copied');\n      btn.innerHTML = '<svg style=\"width:16px;height:16px;fill:#fff;flex-shrink:0\" viewBox=\"0 0 24 24\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"\/><\/svg> 复制成功！';\n      setTimeout(function() {\n        btn.classList.remove('copied');\n        btn.innerHTML = '<svg style=\"width:16px;height:16px;fill:#fff;flex-shrink:0\" viewBox=\"0 0 24 24\"><path d=\"M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z\"\/><\/svg> 一键复制微信号';\n      }, 2000);\n    }\n    if (navigator.clipboard) {\n      navigator.clipboard.writeText(id).then(onCopied);\n    } else {\n      var ta = document.createElement('textarea');\n      ta.value = id; document.body.appendChild(ta);\n      ta.select(); document.execCommand('copy');\n      document.body.removeChild(ta); onCopied();\n    }\n  }\n<\/script>",
